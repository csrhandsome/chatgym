# 复制为 .env；API 根地址不要包含 /api/health。
# 当前后端服务器端口为 3000，Expo/Metro 的端口与 API 端口独立。
EXPO_PUBLIC_API_BASE_URL=http://8.135.57.75:3000
EXPO_PUBLIC_PLAN_API_PATH=/api/agent/plan/stream
EXPO_PUBLIC_CHAT_API_PATH=/api/agent/plan/stream
EXPO_PUBLIC_VLM_API_PATH=/api/agent/vlm/analyze

# 支付默认关闭。开发时可改 mock；正式微信次数购买目前仅 Android 使用 wechat。
EXPO_PUBLIC_PAYMENT_MODE=disabled
# 微信开放平台移动应用 AppID（公开标识，必须与后端下单一致）。
EXPO_PUBLIC_WECHAT_APP_ID=
# 使用 iOS 微信 SDK 时才需要已验证的 HTTPS Universal Link；AI 次数购买另接 IAP。
EXPO_PUBLIC_WECHAT_UNIVERSAL_LINK=
