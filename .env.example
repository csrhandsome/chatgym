# Bun 后端与前端默认 API 端口均为 3000；前端未配置时推断开发机地址。
# 复制为 .env，按实际后端端口设置；Expo Web 的端口与 API 端口独立。
# Android 模拟器使用 http://10.0.2.2:3000，真机使用开发机的局域网 IP。
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
EXPO_PUBLIC_PLAN_API_PATH=/api/agent/plan/stream
EXPO_PUBLIC_CHAT_API_PATH=/api/agent/plan/stream
EXPO_PUBLIC_VLM_API_PATH=/api/agent/vlm/analyze
